{
  "name": "everfit-workout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "jest",
    "test:int": "jest -c test/jest-int.json --runInBand",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "bench:seed": "docker compose exec -T db psql -U everfit -d everfit -v user_id=bench-user < scripts/seed-benchmark.sql",
    "bench:explain": "docker compose exec -T db psql -U everfit -d everfit -v user_id=bench-user < scripts/explain.sql",
    "bench:run": "node scripts/benchmark.mjs"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "joi": "^17.13.9",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "autocannon": "^7.15.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
